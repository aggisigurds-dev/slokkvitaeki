{
  "name": "Ragnarök",
  "description": "Molten-gold on black steel HUD theme for Slökkvitæki / Brunahólf workstation. Chamfered corners, fractured burning rings, ember glow.",
  "fonts": { "display": "Chakra Petch", "mono": "JetBrains Mono", "google": "https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" },
  "colors": {
    "gold": { "100": "#fff4d1", "200": "#ffe7a8", "300": "#ffd98a", "400": "#ffcf6a", "500": "#e6b04a", "600": "#c9982f", "700": "#b5651d", "800": "#7a3a0c", "900": "#3e1a06" },
    "ember": { "100": "#fff0c0", "300": "#ffb347", "500": "#ff9a3a", "600": "#ff8c2a", "700": "#d2691e", "900": "#5a2a08" },
    "red": "#ff5a2a",
    "steel": { "black": "#020202", "900": "#030303", "800": "#070707", "700": "#0c0c0c", "600": "#141414", "500": "#1c1c1c" },
    "text": { "base": "#f3e4bf", "gold": "#ffcf6a", "dim": "#bf9a5d", "muted": "#9c7a45", "faint": "#7d6238", "onGold": "#0a0a0a" },
    "semantic": { "ok": "#ff9a3a", "warn": "#ffcf6a", "danger": "#ff5a2a", "idle": "#bf9a5d" }
  },
  "glow": { "panel": "0 0 22px rgba(255,120,40,.3)", "panelStrong": "0 0 22px rgba(255,120,40,.5)", "text": "0 0 10px rgba(255,140,40,.7)", "shadow": "0 8px 24px rgba(0,0,0,.7)" },
  "geometry": { "chamfer": 14, "chamferSmall": 8, "frameThick": 2, "frameThin": 1.5, "radius": 0, "buttonHeight": 40, "buttonHeightSmall": 34, "buttonHeightLarge": 52 },
  "rings": { "outerSpin": "140s", "innerSpin": "110s reverse", "tickSpin": "300s", "comet": "18s", "activeMultiplier": 3, "flicker": "8s steps(1)" },
  "tailwind": {
    "note": "Drop into tailwind.config theme.extend",
    "colors": { "rg-gold": { "100": "#fff4d1", "400": "#ffcf6a", "500": "#e6b04a", "600": "#c9982f", "700": "#b5651d", "900": "#3e1a06" }, "rg-ember": { "100": "#fff0c0", "500": "#ff9a3a", "600": "#ff8c2a", "700": "#d2691e" }, "rg-steel": { "900": "#030303", "600": "#141414", "500": "#1c1c1c" }, "rg-text": "#f3e4bf", "rg-dim": "#bf9a5d", "rg-muted": "#9c7a45" },
    "fontFamily": { "rg": ["Chakra Petch", "monospace"], "rgmono": ["JetBrains Mono", "monospace"] },
    "boxShadow": { "rg": "0 0 22px rgba(255,120,40,.3), 0 8px 24px rgba(0,0,0,.7)", "rg-strong": "0 0 22px rgba(255,120,40,.5)" }
  }
}
